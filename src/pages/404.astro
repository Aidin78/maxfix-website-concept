---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import { company } from '~/data/company';
import { paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

const t = useTranslations('sv').notFound;
const en = useTranslations('en').notFound;
---

<BaseLayout lang="sv" title={`${t.title} | MaxFix`} alternates={{ sv: '/404/', en: '/404/' }} noindex>
  <section class="nf">
    <div class="container">
      <p class="mono nf__code">404</p>
      <h1>{t.title}</h1>
      <p class="lead">{t.text}</p>
      <div class="nf__actions">
        <a href={paths.home('sv')} class="btn">
          {t.home}
          <Icon name="arrow" class="arrow" />
        </a>
        <a href={company.phone.href} class="btn btn--ghost">
          <Icon name="phone" />
          {company.phone.display}
        </a>
      </div>
      <p class="nf__en" lang="en">
        {en.title}. <a href={paths.home('en')}>{en.home}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }

  .nf__code {
    font-size: clamp(4rem, 3rem + 6vw, 8rem);
    line-height: 1;
    color: var(--accent);
  }

  .nf h1 {
    margin-top: 1rem;
    font-size: var(--step-4);
  }

  .nf .lead {
    margin-top: 1.25rem;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .nf__en {
    margin-top: 3rem;
    color: var(--ink-3);
  }
</style>
