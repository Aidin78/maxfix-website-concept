---
import { Image } from 'astro:assets';
import logo from '~/assets/images/logo.png';

interface Props {
  height?: number;
  class?: string;
}

const { height = 44, class: className } = Astro.props;
const width = Math.round((logo.width / logo.height) * height);
---

<Image
  src={logo}
  alt="MaxFix – fixar dina hemmafix"
  width={width}
  height={height}
  densities={[1, 2]}
  loading="eager"
  class:list={['logo', className]}
/>

<style>
  .logo {
    display: block;
    width: auto;
  }
</style>
