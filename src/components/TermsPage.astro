---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { company } from '~/data/company';
import { skatteverketUrl, terms } from '~/data/terms';
import { type Lang, paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).termsPage;
const doc = terms[lang];

const slugify = (text: string) =>
  text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const sections = doc.sections.map((s) => ({ ...s, id: slugify(s.heading) }));
const toc = sections.filter((s) => s.level === 2);

const details = [
  { label: t.legalName, value: company.legalName },
  { label: t.address, value: `${company.address.street}, ${company.address.postalCode} ${company.address.locality}` },
  { label: t.email, value: company.email, href: `mailto:${company.email}` },
  { label: t.orgNr, value: company.orgNumber },
  { label: t.vat, value: company.vatNumber },
  { label: t.phone, value: company.phone.display, href: company.phone.href },
];
---

<BaseLayout
  lang={lang}
  title={`${doc.title} | MaxFix`}
  description={doc.intro}
  alternates={{ sv: paths.terms('sv'), en: paths.terms('en') }}
>
  <article class="terms">
    <div class="container terms__grid">
      <header class="terms__head">
        <p class="eyebrow">MaxFix</p>
        <h1>{doc.title}</h1>
        <p class="lead">{doc.intro}</p>
        <nav class="terms__toc" aria-label={doc.title}>
          <ul>
            {
              toc.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.heading}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <div class="terms__body">
        {
          sections.map((s) => {
            const Heading = s.level === 2 ? 'h2' : s.level === 3 ? 'h4' : 'h3';
            return (
              <section id={s.id} class:list={['terms__section', `terms__section--${s.level ?? 'item'}`]}>
                <Heading>{s.heading}</Heading>
                {s.blocks.map((block) =>
                  typeof block === 'string' ? (
                    <p>{block}</p>
                  ) : (
                    <ul>
                      {block.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  ),
                )}
              </section>
            );
          })
        }

        <p class="terms__more">
          <a href={skatteverketUrl} class="text-link" target="_blank" rel="noopener">
            {t.readMore}
            <Icon name="arrow-up-right" size={18} />
          </a>
        </p>

        <section class="terms__company" aria-labelledby="company-details">
          <h2 id="company-details">{t.companyTitle}</h2>
          <dl>
            {
              details.map((d) => (
                <div>
                  <dt>{d.label}</dt>
                  <dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .terms {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) var(--section);
  }

  .terms__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  @media (min-width: 1000px) {
    .terms__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }

    .terms__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .terms__head h1 {
    margin-top: 1.25rem;
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .terms__head .lead {
    margin-top: 1.25rem;
  }

  .terms__toc ul {
    list-style: none;
    margin-top: 2rem;
    border-top: 1px solid var(--line-strong);
  }

  .terms__toc a {
    display: block;
    padding: 0.7rem 0;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
  }

  .terms__toc a:hover {
    color: var(--accent);
  }

  .terms__body {
    max-width: 44em;
  }

  .terms__section {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .terms__section h2 {
    margin-top: 3rem;
    padding-top: 1.5rem;
    font-size: var(--step-2);
    border-top: 1px solid var(--line-strong);
  }

  .terms__section:first-child h2 {
    margin-top: 0;
  }

  .terms__section h3 {
    margin-top: 2rem;
    font-size: var(--step-1);
  }

  .terms__section h4 {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .terms__section p,
  .terms__section ul {
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .terms__section ul {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
  }

  .terms__more {
    margin-top: 2.5rem;
  }

  .terms__company {
    margin-top: 3rem;
    padding: 1.75rem;
    background: var(--paper-2);
    border-radius: var(--radius-lg);
  }

  .terms__company h2 {
    font-size: var(--step-2);
  }

  .terms__company dl {
    display: grid;
    gap: 0;
    margin: 1rem 0 0;
  }

  .terms__company div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.15rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .terms__company div {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .terms__company dt {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .terms__company dd {
    margin: 0;
    font-weight: 500;
  }
</style>
