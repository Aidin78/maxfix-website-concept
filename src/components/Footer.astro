---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { company } from '~/data/company';
import { services } from '~/data/services';
import { type Lang, paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
  alternateUrl: string;
}

const { lang, alternateUrl } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const companyLinks = [
  { label: t.nav.about, href: paths.section(lang, 'about') },
  { label: t.nav.pricing, href: paths.section(lang, 'pricing') },
  { label: t.nav.reviews, href: paths.section(lang, 'reviews') },
  { label: t.nav.gallery, href: paths.gallery(lang) },
  { label: t.footer.tips, href: paths.section(lang, 'tips') },
  { label: t.footer.terms, href: paths.terms(lang) },
];
---

<footer class="footer on-night">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__logo">
          <Logo height={52} />
        </span>
        <p>{t.footer.tagline}</p>
        <div class="footer__social">
          <a href={company.social.instagram} rel="noopener" target="_blank" aria-label="Instagram">
            <Icon name="instagram" size={20} />
          </a>
          <a href={company.social.facebook} rel="noopener" target="_blank" aria-label="Facebook">
            <Icon name="facebook" size={20} />
          </a>
        </div>
      </div>

      <nav class="footer__col" aria-labelledby="footer-services">
        <h2 id="footer-services" class="footer__heading">{t.footer.services}</h2>
        <ul class="footer__list footer__list--two">
          {
            services.map((s) => (
              <li>
                <a href={paths.service(lang, s.slug[lang])}>{s.title[lang]}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer__col" aria-labelledby="footer-company">
        <h2 id="footer-company" class="footer__heading">{t.footer.company}</h2>
        <ul class="footer__list">
          {
            companyLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__heading">{t.footer.contact}</h2>
        <address class="footer__contact">
          <a href={company.phone.href} class="footer__phone">{company.phone.display}</a>
          <span class="footer__muted">{t.contact.phoneHours}</span>
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <span>
            {company.legalName}<br />
            {company.address.street}<br />
            {`${company.address.postalCode} ${company.address.locality}`}
          </span>
        </address>
      </div>
    </div>

    <div class="ruler footer__ruler" aria-hidden="true"></div>

    <div class="footer__bottom">
      <p>
        {`© ${year} ${company.legalName} · ${t.contact.orgNr} ${company.orgNumber} · ${t.footer.vat} ${company.vatNumber}`}
      </p>
      <a href={alternateUrl} hreflang={lang === 'sv' ? 'en' : 'sv'}>{t.nav.language}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: var(--ink-on-night);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
    font-size: 0.95rem;
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 720px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .footer__top {
      grid-template-columns: 1.3fr 1.2fr 0.8fr 1fr;
      gap: 3rem;
    }
  }

  .footer__logo {
    display: inline-block;
    padding: 0.6rem 0.8rem;
    background: var(--white);
    border-radius: var(--radius);
  }

  .footer__brand p {
    margin-top: 1.25rem;
    max-width: 28ch;
    color: var(--ink-on-night-2);
  }

  .footer__social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-on-night);
    border-radius: var(--radius);
    color: var(--ink-on-night);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .footer__social a:hover {
    border-color: var(--accent-on-night);
    color: var(--accent-on-night);
  }

  .footer__heading {
    margin-bottom: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-on-night-2);
  }

  .footer__list {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .footer__list--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
  }

  .footer a {
    color: var(--ink-on-night);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--accent-on-night);
  }

  .footer__contact {
    display: grid;
    gap: 0.55rem;
    font-style: normal;
  }

  .footer__phone {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .footer__muted,
  .footer__contact span {
    color: var(--ink-on-night-2);
  }

  .footer__ruler {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--ink-on-night-2);
  }
</style>
