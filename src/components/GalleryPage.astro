---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { categories, work } from '~/data/gallery';
import { type Lang, paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const g = t.galleryPage;

const items = await Promise.all(
  work.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.image, width: Math.min(1800, item.image.width), format: 'webp' }),
  })),
);
const usedCategories = categories.filter((c) => work.some((w) => w.category === c.id));
---

<BaseLayout
  lang={lang}
  title={`${g.title} | MaxFix`}
  description={g.lead}
  alternates={{ sv: paths.gallery('sv'), en: paths.gallery('en') }}
>
  <section class="gallery">
    <div class="container">
      <header class="gallery__head">
        <p class="eyebrow">{t.work.eyebrow}</p>
        <h1>{g.title}</h1>
        <p class="lead">{g.lead}</p>
      </header>

      <div class="gallery__filters" role="group" aria-label={g.filterLabel}>
        <button type="button" class="filter" aria-pressed="true" data-filter="all">{g.all}</button>
        {
          usedCategories.map((c) => (
            <button type="button" class="filter" aria-pressed="false" data-filter={c.id}>
              {c.label[lang]}
            </button>
          ))
        }
      </div>

      <ul class="gallery__grid" data-gallery>
        {
          items.map((item, i) => (
            <li id={item.id} class="gallery__item" data-category={item.category}>
              <button
                type="button"
                class="gallery__open"
                data-index={i}
                data-full={item.full.src}
                data-caption={item.caption[lang]}
                aria-label={`${g.open}: ${item.caption[lang]}`}
              >
                <Image
                  src={item.image}
                  alt={item.caption[lang]}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
              </button>
              <p class="gallery__caption">
                <span>{item.caption[lang]}</span>
                {item.date && <span class="mono">{item.date}</span>}
              </p>
            </li>
          ))
        }
      </ul>

      <div class="gallery__cta">
        <p>{t.servicePage.ctaText}</p>
        <a href={paths.section(lang, 'contact')} class="btn">
          {t.nav.cta}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label={g.title}>
    <figure class="lightbox__figure">
      <img data-lightbox-img alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label={g.close}>
      <Icon name="close" />
    </button>
    <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label={g.prev}>
      <Icon name="arrow-left" />
    </button>
    <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label={g.next}>
      <Icon name="arrow" />
    </button>
  </dialog>
</BaseLayout>

<style>
  .gallery {
    padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) var(--section);
  }

  .gallery__head h1 {
    margin-top: 1.25rem;
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .gallery__head .lead {
    margin-top: 1.25rem;
  }

  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .filter {
    min-height: 2.6rem;
    padding: 0.45rem 1rem;
    font-weight: 500;
    font-size: 0.95rem;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .filter:hover {
    border-color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .gallery__grid {
    list-style: none;
    columns: 1;
    column-gap: 1.25rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .gallery__grid {
      columns: 2;
    }
  }

  @media (min-width: 1100px) {
    .gallery__grid {
      columns: 3;
    }
  }

  .gallery__item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .gallery__item[hidden] {
    display: none;
  }

  .gallery__item:target .gallery__open {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .gallery__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--paper-3);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
  }

  .gallery__open :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.8s var(--ease-out);
  }

  .gallery__open:hover :global(img) {
    transform: scale(1.03);
  }

  .gallery__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .gallery__caption .mono {
    flex: none;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .gallery__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
    padding: 2rem;
    background: var(--paper-2);
    border-radius: var(--radius-lg);
  }

  .gallery__cta p {
    font-size: var(--step-1);
    font-weight: 600;
    max-width: 30em;
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem) clamp(1rem, 7vw, 6rem);
    border: 0;
    background: rgb(12 20 25 / 0.94);
    color: var(--ink-on-night);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade 0.25s var(--ease-out);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__figure {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    margin: 0;
    max-height: 100%;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    width: auto;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox__figure figcaption {
    max-width: 50em;
    text-align: center;
    font-size: 0.95rem;
    color: var(--ink-on-night-2);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--ink-on-night);
    background: rgb(246 242 235 / 0.08);
    border: 1px solid var(--line-on-night);
    border-radius: 50%;
    transition: background-color 0.2s;
  }

  .lightbox__btn:hover {
    background: rgb(246 242 235 / 0.2);
  }

  .lightbox__btn:focus-visible {
    outline-color: var(--accent-on-night);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    margin-top: -1.5rem;
  }

  .lightbox__prev {
    left: 1rem;
  }

  .lightbox__next {
    right: 1rem;
  }

  @media (max-width: 639px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      margin-top: 0;
    }

    .lightbox__prev {
      left: calc(50% - 3.5rem);
    }

    .lightbox__next {
      right: calc(50% - 3.5rem);
    }

    .lightbox__figure img {
      max-height: calc(100dvh - 12rem);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.gallery__item'));

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((item) => {
        item.hidden = key !== 'all' && item.dataset.category !== key;
      });
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
  const openers = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery__open'));
  let current = 0;
  let returnFocus: HTMLElement | null = null;

  const visible = () => openers.filter((o) => !o.closest('li')?.hidden);

  function show(opener: HTMLButtonElement) {
    if (!img || !caption) return;
    current = visible().indexOf(opener);
    img.src = opener.dataset.full ?? '';
    img.alt = opener.dataset.caption ?? '';
    caption.textContent = opener.dataset.caption ?? '';
  }

  function step(delta: number) {
    const list = visible();
    if (!list.length) return;
    const next = list[(current + delta + list.length) % list.length];
    if (next) show(next);
  }

  openers.forEach((opener) => {
    opener.addEventListener('click', () => {
      if (!dialog) return;
      returnFocus = opener;
      show(opener);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
  });

  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => step(-1));
  dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => step(1));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') step(-1);
    if (event.key === 'ArrowRight') step(1);
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    returnFocus?.focus();
  });
</script>
