---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import heroImage from '~/assets/images/car-gamla-stan.jpg';
import recoBadge from '~/assets/images/reco-badge.png';
import { company } from '~/data/company';
import { rates } from '~/data/pricing';
import { type Lang, paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">{t.hero.titleA}</span>
        <span class="hero__line">
          <span class="hero__underline">
            {t.hero.titleB}
            <svg viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true">
              <path d="M3 13.5C60 6 150 3.5 297 8.5" pathLength="1"></path>
            </svg>
          </span>
        </span>
      </h1>
      <p class="lead hero__lead">{t.hero.lead}</p>
      <div class="hero__actions">
        <a href={paths.section(lang, 'contact')} class="btn">
          {t.hero.primary}
          <Icon name="arrow" class="arrow" />
        </a>
        <a href={paths.section(lang, 'services')} class="btn btn--ghost">{t.hero.secondary}</a>
      </div>
      <p class="hero__call">
        <span>{t.hero.callLine}</span>
        <a href={company.phone.href}>
          <Icon name="phone" size={18} />
          {company.phone.display}
        </a>
        <span class="hero__hours">{t.hero.hours}</span>
      </p>
    </div>

    <figure class="hero__media">
      <div class="hero__frame">
        <Image
          src={heroImage}
          alt={t.hero.imageAlt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1000px) 40vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
      <p class="hero__tag">
        <span class="hero__tag-from">{t.hero.priceFrom}</span>
        <span class="hero__tag-price">
          {rates.fromPerHour}<small>{t.hero.priceUnit}</small>
        </span>
        <span class="hero__tag-note">{t.hero.priceNote}</span>
      </p>
      <figcaption class="mono hero__caption">{t.hero.imageCaption}</figcaption>
    </figure>
  </div>

  <div class="container">
    <div class="ruler hero__ruler" aria-hidden="true"></div>
    <ul class="hero__facts">
      <li class="hero__fact hero__fact--badge">
        <Image src={recoBadge} alt="" width={120} densities={[1, 2]} class="hero__badge" />
        <span>
          <strong>{t.hero.facts[0].value}</strong>
          {t.hero.facts[0].label}
        </span>
      </li>
      {
        t.hero.facts.slice(1).map((fact) => (
          <li class="hero__fact">
            <span>
              <strong>{fact.value}</strong>
              {fact.label}
            </span>
          </li>
        ))
      }
      <li class="hero__fact hero__fact--price">
        <span>
          <strong>
            {t.hero.priceFrom} {rates.fromPerHour} {t.hero.priceUnit}
          </strong>
          {t.hero.priceNote}
        </span>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(2.5rem, 2rem + 2vw, 4rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .hero__title {
    margin-top: 1.4rem;
    font-size: var(--step-5);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero__line {
    display: block;
  }

  .hero__underline {
    position: relative;
    display: inline-block;
    color: var(--ink);
  }

  .hero__underline svg {
    position: absolute;
    left: -2%;
    bottom: -0.16em;
    width: 104%;
    height: 0.24em;
    overflow: visible;
  }

  .hero__underline path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__underline path {
      stroke-dashoffset: 1;
      animation: draw 1.1s 0.5s var(--ease-out) forwards;
    }

    .hero__copy > * {
      animation: rise 0.9s var(--ease-out) both;
    }

    .hero__copy > :nth-child(2) {
      animation-delay: 0.06s;
    }

    .hero__copy > :nth-child(3) {
      animation-delay: 0.14s;
    }

    .hero__copy > :nth-child(4) {
      animation-delay: 0.2s;
    }

    .hero__copy > :nth-child(5) {
      animation-delay: 0.26s;
    }

    .hero__frame {
      animation: reveal-frame 1.2s 0.1s var(--ease-out) both;
    }

    .hero__img {
      animation: settle 1.6s 0.1s var(--ease-out) both;
    }

    .hero__tag {
      animation: swing-in 0.9s 0.7s var(--ease-out) both;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes reveal-frame {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes swing-in {
    from {
      opacity: 0;
      transform: translateY(-12px) rotate(-6deg);
    }
  }

  .hero__lead {
    margin-top: 1.75rem;
    max-width: 34em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 599px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  .hero__call {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: 1.5rem;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  .hero__call a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.2s;
  }

  .hero__call a:hover {
    border-color: var(--accent);
  }

  .hero__hours {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  /* ---------- Media ---------- */
  .hero__media {
    position: relative;
    margin: 0;
  }

  .hero__frame {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-3);
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 1000px) {
    .hero__frame {
      aspect-ratio: 5 / 6;
    }
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 82% 60%;
  }

  .hero__caption {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--ink-3);
    text-align: right;
  }

  .hero__tag {
    position: absolute;
    left: clamp(-1.5rem, -2vw, -0.5rem);
    top: 2.5rem;
    margin: 0;
    display: grid;
    gap: 0.1rem;
    padding: 1.4rem 1.4rem 1.1rem;
    min-width: 11.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -24px rgb(20 35 43 / 0.55);
    transform-origin: 50% 0;
  }

  .hero__tag::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin-left: -0.275rem;
    border-radius: 50%;
    background: var(--paper-2);
    box-shadow: inset 0 1px 2px rgb(20 35 43 / 0.25);
  }

  .hero__tag-from {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .hero__tag-price {
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .hero__tag-price small {
    margin-left: 0.3rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .hero__tag-note {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 999px) {
    .hero__tag {
      left: auto;
      right: 1rem;
      top: 1rem;
      padding: 1.1rem 1.1rem 0.9rem;
      min-width: 0;
    }

    .hero__tag-price {
      font-size: 2rem;
    }
  }

  @media (max-width: 479px) {
    .hero__tag {
      display: none;
    }
  }

  /* ---------- Facts ---------- */
  .hero__ruler {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .hero__facts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    padding-top: 1.5rem;
  }

  @media (min-width: 900px) {
    .hero__facts {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 0;
    }

    .hero__fact + .hero__fact {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }

    .hero__fact {
      padding-right: 1.5rem;
    }
  }

  .hero__fact {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.92rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .hero__fact strong {
    display: block;
    margin-bottom: 0.15rem;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero__fact--badge {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .hero__fact--badge {
      grid-column: auto;
    }
  }

  .hero__badge {
    flex: none;
    width: 88px;
    height: auto;
  }

  @media (min-width: 480px) {
    .hero__fact--price {
      display: none;
    }
  }

  @media (max-width: 479px) {
    .hero__fact--price {
      grid-column: 1 / -1;
    }
  }
</style>
