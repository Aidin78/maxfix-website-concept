---
import Icon from '~/components/Icon.astro';
import { estimatorRates, pricing, rates } from '~/data/pricing';
import { type Lang, formatNumber } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).pricing.estimator;
const options = estimatorRates.map((id) => {
  const row = pricing[lang].labour.find((r) => r.id === id);
  if (!row) throw new Error(`Missing rate ${id}`);
  return { id, price: row.price, label: t.labels[id] };
});
const initial = options[0]!;
const initialLabour = initial.price * rates.minimumHours;
---

<form
  class="estimator"
  data-estimator
  data-travel={rates.travelPerVisit}
  data-locale={lang === 'sv' ? 'sv-SE' : 'en-GB'}
  aria-labelledby="estimator-title"
>
  <h3 id="estimator-title" class="estimator__title">
    <Icon name="ruler" size={22} />
    {t.title}
  </h3>

  <fieldset class="estimator__field">
    <legend>{t.type}</legend>
    <div class="estimator__options">
      {
        options.map((o, i) => (
          <label class="estimator__option">
            <input type="radio" name="rate" value={o.price} checked={i === 0} />
            <span>
              {o.label}
              <small class="mono">
                {o.price} {t.currency}
              </small>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="estimator__field">
    <label for="estimator-hours" class="estimator__label">{t.hours}</label>
    <div class="estimator__stepper">
      <button type="button" data-step="-0.5" aria-label={t.decrease}>
        <Icon name="minus" size={18} />
      </button>
      <input
        id="estimator-hours"
        name="hours"
        type="number"
        inputmode="decimal"
        min={rates.minimumHours}
        max="40"
        step="0.5"
        value={rates.minimumHours}
      />
      <span class="estimator__unit mono" aria-hidden="true">{t.hoursUnit}</span>
      <button type="button" data-step="0.5" aria-label={t.increase}>
        <Icon name="plus" size={18} />
      </button>
    </div>
  </div>

  <dl class="estimator__result" aria-live="polite">
    <div>
      <dt>{t.labour}</dt>
      <dd><span data-out="labour">{formatNumber(initialLabour, lang)}</span> {t.currency}</dd>
    </div>
    <div>
      <dt>{t.travel}</dt>
      <dd>{formatNumber(rates.travelPerVisit, lang)} {t.currency}</dd>
    </div>
    <div class="estimator__total">
      <dt>{t.total}</dt>
      <dd>
        <span data-out="total">{formatNumber(initialLabour + rates.travelPerVisit, lang)}</span>{' '}
        {t.currency}
      </dd>
    </div>
  </dl>

  <p class="estimator__note">{t.note}</p>
</form>

<style>
  .estimator {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -40px rgb(0 0 0 / 0.6);
  }

  .estimator__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-2);
  }

  .estimator__title :global(svg) {
    color: var(--accent);
  }

  .estimator__field {
    margin: 1.5rem 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .estimator__field legend,
  .estimator__label {
    display: block;
    margin-bottom: 0.6rem;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .estimator__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .estimator__option {
    position: relative;
    cursor: pointer;
  }

  .estimator__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .estimator__option span {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.75rem 0.85rem;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      color 0.2s;
  }

  .estimator__option small {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-3);
  }

  .estimator__option:hover span {
    border-color: var(--ink);
  }

  .estimator__option input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .estimator__option input:checked + span small {
    color: var(--ink-on-night-2);
  }

  .estimator__option input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .estimator__stepper {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 3rem;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .estimator__stepper button {
    display: grid;
    place-items: center;
    height: 3rem;
    border: 0;
    background: transparent;
    transition: background-color 0.2s;
  }

  .estimator__stepper button:hover {
    background: var(--paper-2);
  }

  .estimator__stepper button:first-child {
    border-right: 1px solid var(--line);
  }

  .estimator__stepper button:last-child {
    border-left: 1px solid var(--line);
  }

  .estimator__stepper input {
    width: 100%;
    height: 3rem;
    padding: 0 0.25rem 0 1rem;
    border: 0;
    background: transparent;
    font-size: var(--step-1);
    font-weight: 700;
    text-align: right;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .estimator__stepper input::-webkit-outer-spin-button,
  .estimator__stepper input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .estimator__stepper input:focus-visible {
    outline-offset: -3px;
  }

  .estimator__unit {
    padding: 0 1rem 0 0.4rem;
    color: var(--ink-3);
  }

  .estimator__result {
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .estimator__result > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .estimator__result dt {
    color: var(--ink-2);
  }

  .estimator__result dd {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    white-space: nowrap;
  }

  .estimator__result .estimator__total {
    align-items: baseline;
    border-bottom: 0;
    padding-top: 1rem;
  }

  .estimator__total dt {
    font-weight: 700;
    color: var(--ink);
  }

  .estimator__total dd {
    font-family: var(--font-sans);
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .estimator__note {
    margin-top: 0.75rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-estimator]').forEach((form) => {
    const hours = form.querySelector<HTMLInputElement>('input[name="hours"]');
    const labourOut = form.querySelector<HTMLElement>('[data-out="labour"]');
    const totalOut = form.querySelector<HTMLElement>('[data-out="total"]');
    const travel = Number(form.dataset.travel ?? 0);
    const fmt = new Intl.NumberFormat(form.dataset.locale);
    if (!hours) return;

    const min = Number(hours.min);
    const max = Number(hours.max);

    const clamp = (value: number) => {
      if (Number.isNaN(value)) return min;
      // Billing is per started half hour.
      return Math.min(max, Math.max(min, Math.ceil(value * 2) / 2));
    };

    const update = () => {
      const rate = Number(form.querySelector<HTMLInputElement>('input[name="rate"]:checked')?.value ?? 0);
      const h = clamp(hours.valueAsNumber);
      const labour = rate * h;
      if (labourOut) labourOut.textContent = fmt.format(labour);
      if (totalOut) totalOut.textContent = fmt.format(labour + travel);
    };

    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('change', (e) => {
      if (e.target === hours) hours.value = String(clamp(hours.valueAsNumber));
      update();
    });
    hours.addEventListener('input', update);

    form.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        hours.value = String(clamp(hours.valueAsNumber + Number(btn.dataset.step)));
        update();
      });
    });
  });
</script>
