---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import { featuredWork, work } from '~/data/gallery';
import { type Lang, anchors, paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).work;
const items = featuredWork
  .map((id) => work.find((w) => w.id === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));
---

<section id={anchors[lang].work} class="section work" data-section="gallery" aria-labelledby="work-title">
  <div class="container">
    <header class="work__head" data-reveal>
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="work-title">{t.title}</h2>
      </div>
      <p class="lead">{t.lead}</p>
      <a href={paths.gallery(lang)} class="btn btn--ghost work__all">
        {t.all}
        <Icon name="arrow" class="arrow" />
      </a>
    </header>

    <ul class="work__grid">
      {
        items.map((item, i) => (
          <li class={`work__item work__item--${i + 1}`} data-reveal style={`--reveal-delay:${(i % 3) * 0.08}s`}>
            <a href={`${paths.gallery(lang)}#${item.id}`} class="work__link">
              <span class="work__frame">
                <Image
                  src={item.image}
                  alt={item.caption[lang]}
                  widths={[400, 640, 960]}
                  sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
                />
              </span>
              <span class="work__caption">
                <span>{item.caption[lang]}</span>
                {item.date && <span class="mono">{item.date}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .work__head h2 {
    margin-top: 1.25rem;
    font-size: var(--step-4);
  }

  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto;
      align-items: end;
      gap: 3rem;
    }
  }

  .work__all {
    justify-self: start;
  }

  .work__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
  }

  @media (min-width: 900px) {
    .work__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(11rem, 8rem + 8vw, 17rem);
    }

    .work__item--1 {
      grid-column: span 2;
      grid-row: span 2;
    }

    .work__item--4,
    .work__item--5 {
      grid-row: span 2;
    }

    .work__item--6 {
      grid-column: span 2;
    }
  }

  .work__item--1,
  .work__item--6 {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .work__item--1,
    .work__item--6 {
      grid-column: span 2;
    }
  }

  .work__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .work__frame {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-3);
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 900px) {
    .work__frame {
      aspect-ratio: auto;
    }
  }

  .work__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .work__link:hover .work__frame :global(img) {
    transform: scale(1.04);
  }

  .work__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .work__caption > span:first-child {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  .work__caption .mono {
    flex: none;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .work__link:hover .work__caption > span:first-child {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
