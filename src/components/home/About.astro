---
import { Image } from 'astro:assets';
import vanImage from '~/assets/images/van-gamla-stan.jpg';
import { type Lang, anchors } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).about;
---

<section id={anchors[lang].about} class="section section--sand about" data-section="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <figure class="about__media" data-reveal>
      <div class="about__frame">
        <Image
          src={vanImage}
          alt={t.imageAlt}
          widths={[480, 720, 960]}
          sizes="(min-width: 1000px) 38vw, 100vw"
          class="about__img"
        />
      </div>
      <figcaption class="mono">Gamla stan, Stockholm</figcaption>
    </figure>

    <div class="about__copy">
      <header data-reveal>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="about-title">{t.title}</h2>
      </header>

      <p class="about__intro" data-reveal>{t.intro}</p>

      <div class="about__body" data-reveal>
        <p>{t.paragraphs[0]}</p>
        <blockquote class="about__quote">
          <p>{t.quote}</p>
        </blockquote>
        {t.paragraphs.slice(1).map((p) => <p>{p}</p>)}
        <p class="about__signature">
          <span class="about__sig-line" aria-hidden="true"></span>
          {t.signature}
        </p>
      </div>

      <ol class="timeline" data-reveal>
        {
          t.timeline.map((item) => (
            <li>
              <span class="timeline__year mono">{item.year}</span>
              <span class="timeline__text">{item.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }

  @media (min-width: 1000px) {
    .about__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }

    .about__media {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .about__media {
    margin: 0;
  }

  .about__frame {
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
    background: var(--paper-3);
  }

  @media (max-width: 999px) {
    .about__frame {
      aspect-ratio: 4 / 3;
    }
  }

  .about__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  .about__media figcaption {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  .about__copy h2 {
    margin-top: 1.25rem;
    font-size: var(--step-4);
  }

  .about__intro {
    margin-top: 2rem;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    max-width: 30em;
  }

  .about__body {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    max-width: 38em;
    color: var(--ink-2);
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .about__quote {
    position: relative;
    margin: 1.25rem 0;
    padding: 1.75rem 0 1.75rem 1.75rem;
    border-left: 3px solid var(--accent);
  }

  .about__quote p {
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .about__signature {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink);
  }

  .about__sig-line {
    width: 2.5rem;
    height: 1px;
    background: var(--ink);
  }

  .timeline {
    list-style: none;
    margin-top: 3rem;
    border-top: 1px solid var(--line-strong);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .timeline__year {
    font-weight: 500;
    color: var(--accent-text);
  }

  .timeline__text {
    color: var(--ink-2);
  }

  @media (max-width: 479px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
