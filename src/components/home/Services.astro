---
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import hallGarderob from '~/assets/images/gallery/hall-garderob.jpg';
import bokhylla3d from '~/assets/images/gallery/bokhylla-3d.jpg';
import { getService, serviceGroups, services } from '~/data/services';
import { type Lang, anchors, paths } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const grouped = serviceGroups.map((group) => ({
  ...group,
  items: services.filter((s) => s.group === group.id),
}));
const indexed = grouped.flatMap((g) => g.items);
const numberOf = (id: string) => String(indexed.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const featured = getService('platsbyggt');
---

<section id={anchors[lang].services} class="section section--sand services" data-section="services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head section-head--split" data-reveal>
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 id="services-title">{t.services.title}</h2>
      <p class="lead">{t.services.lead}</p>
    </header>

    <div class="services__layout">
      <div class="services__preview" aria-hidden="true" data-reveal>
        <div class="services__preview-frame">
          {
            indexed.map((s, i) => (
              <Image
                src={s.image}
                alt=""
                widths={[480, 720, 960]}
                sizes="(min-width: 1000px) 36vw, 0px"
                loading={i === 0 ? 'eager' : 'lazy'}
                class:list={['services__preview-img', { 'is-active': i === 0 }]}
                data-preview={s.id}
              />
            ))
          }
        </div>
        <p class="services__preview-caption mono" data-preview-caption>
          {indexed[0]?.title[lang]}
        </p>
      </div>

      <div class="services__index">
        {
          grouped.map((group) => (
            <div class="services__group" data-reveal>
              <h3 class="services__group-title">
                <span>{group.label[lang]}</span>
                <span class="mono">{String(group.items.length).padStart(2, '0')}</span>
              </h3>
              <ul class="services__list">
                {group.items.map((s) => (
                  <li>
                    <a href={paths.service(lang, s.slug[lang])} class="service-row" data-service={s.id}>
                      <span class="service-row__thumb" aria-hidden="true">
                        <Image src={s.image} alt="" width={128} height={128} densities={[1, 2]} />
                      </span>
                      <span class="service-row__num mono" aria-hidden="true">
                        {numberOf(s.id)}
                      </span>
                      <span class="service-row__body">
                        <span class="service-row__title">
                          {s.title[lang]}
                          {s.priceNote && <span class="service-row__price mono">{s.priceNote[lang]}</span>}
                        </span>
                        <span class="service-row__examples">{s.examples[lang].join(' · ')}</span>
                      </span>
                      <Icon name="arrow" class="service-row__arrow" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <a href={paths.section(lang, 'tips')} class="services__tips" data-reveal>
          <Icon name="ruler" size={28} />
          <span>
            <strong>{t.services.tipsTitle}</strong>
            {t.services.tipsText}
          </span>
          <Icon name="arrow" class="service-row__arrow" />
        </a>
      </div>
    </div>

    <article class="featured" data-reveal>
      <div class="featured__media">
        <Image
          src={featured.image}
          alt={featured.imageAlt[lang]}
          widths={[560, 840, 1120]}
          sizes="(min-width: 1000px) 45vw, 100vw"
          class="featured__main"
        />
        <Image
          src={hallGarderob}
          alt={lang === 'sv' ? 'Platsbyggd garderob och skohylla i en hall' : 'Built-in wardrobe and shoe rack in a hallway'}
          widths={[320, 480, 640]}
          sizes="(min-width: 1000px) 18vw, 40vw"
          class="featured__inset"
        />
      </div>
      <div class="featured__copy">
        <p class="featured__badge mono">{t.services.featuredEyebrow}</p>
        <h3>{t.services.featuredTitle}</h3>
        <p>{t.services.featuredText}</p>
        <ul class="featured__list">
          {
            featured.page[lang].conditions?.map((c) => (
              <li>
                <Icon name="check" size={18} />
                <span>
                  <strong>{c.title}.</strong> {c.text}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="featured__foot">
          <a href={paths.service(lang, featured.slug[lang])} class="btn">
            {t.services.featuredCta}
            <Icon name="arrow" class="arrow" />
          </a>
          <figure class="featured__model">
            <Image src={bokhylla3d} alt="" width={160} densities={[1, 2]} />
            <figcaption class="mono">3D</figcaption>
          </figure>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .services__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 1000px) {
    .services__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 4vw, 5rem);
      align-items: start;
    }
  }

  /* ---------- Preview ---------- */
  .services__preview {
    display: none;
  }

  @media (min-width: 1000px) {
    .services__preview {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .services__preview-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-3);
  }

  .services__preview-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .services__preview-img.is-active {
    opacity: 1;
    transform: none;
  }

  .services__preview-caption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .services__preview-caption::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border-radius: 50%;
  }

  /* ---------- Index ---------- */
  .services__group + .services__group {
    margin-top: 2.75rem;
  }

  .services__group-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--line-strong);
  }

  .services__list {
    list-style: none;
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0.5rem 1.15rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-out),
      padding 0.3s var(--ease-out);
  }

  .service-row__thumb {
    display: none;
  }

  .service-row__num {
    font-size: 0.78rem;
    color: var(--ink-3);
    width: 2rem;
  }

  .service-row__body {
    display: grid;
    gap: 0.25rem;
  }

  .service-row__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.15;
    transition: transform 0.35s var(--ease-out);
  }

  .service-row__price {
    padding: 0.2rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent-text);
    background: var(--accent-tint);
    border-radius: 2px;
    white-space: nowrap;
  }

  .service-row__examples {
    font-size: 0.92rem;
    color: var(--ink-3);
    transition: transform 0.35s var(--ease-out);
  }

  :global(.service-row__arrow) {
    color: var(--ink-3);
    transition:
      transform 0.35s var(--ease-out),
      color 0.2s;
  }

  .service-row:hover,
  .service-row.is-active {
    background: var(--paper);
    padding-left: 1rem;
  }

  .service-row:hover .service-row__title,
  .service-row.is-active .service-row__title {
    color: var(--ink);
  }

  .service-row:hover :global(.service-row__arrow),
  .service-row:focus-visible :global(.service-row__arrow) {
    color: var(--accent);
    transform: translateX(4px);
  }

  @media (max-width: 999px) {
    .service-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding-right: 0;
    }

    .service-row__num {
      display: none;
    }

    .service-row__thumb {
      display: block;
      width: 4rem;
      height: 4rem;
      overflow: hidden;
      border-radius: var(--radius);
      background: var(--paper-3);
    }

    .service-row__thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .service-row:hover,
    .service-row.is-active {
      padding-left: 0;
      background: transparent;
    }
  }

  .services__tips {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-top: 2.75rem;
    padding: 1.25rem 1.25rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink-2);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .services__tips strong {
    display: block;
    color: var(--ink);
    font-size: var(--step-1);
  }

  .services__tips:hover {
    border-color: var(--accent);
    background: var(--paper);
  }

  .services__tips:hover :global(.service-row__arrow) {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* ---------- Featured: platsbyggt ---------- */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 1000px) {
    .featured {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 6rem);
      align-items: center;
    }
  }

  .featured__media {
    position: relative;
    padding-bottom: 12%;
    padding-right: 14%;
  }

  .featured__main {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .featured__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 38%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 6px solid var(--paper-2);
    border-radius: var(--radius);
  }

  .featured__badge {
    display: inline-block;
    padding: 0.35rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--ink);
    border-radius: 2px;
  }

  .featured__copy h3 {
    margin-top: 1.25rem;
    font-size: var(--step-3);
  }

  .featured__copy > p:not(.featured__badge) {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .featured__list {
    list-style: none;
    display: grid;
    gap: 0.85rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .featured__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
  }

  .featured__list :global(svg) {
    margin-top: 0.2rem;
    color: var(--accent);
  }

  .featured__list strong {
    color: var(--ink);
  }

  .featured__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .featured__model {
    position: relative;
    margin: 0;
    width: 5.5rem;
    flex: none;
  }

  .featured__model :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }

  .featured__model figcaption {
    position: absolute;
    top: -0.6rem;
    right: -0.6rem;
    padding: 0.15rem 0.4rem;
    font-size: 0.7rem;
    color: #fff;
    background: var(--accent);
    border-radius: 2px;
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLAnchorElement>('[data-service]');
  const images = document.querySelectorAll<HTMLElement>('[data-preview]');
  const caption = document.querySelector<HTMLElement>('[data-preview-caption]');

  function activate(row: HTMLAnchorElement) {
    const id = row.dataset.service;
    images.forEach((img) => img.classList.toggle('is-active', img.dataset.preview === id));
    rows.forEach((r) => r.classList.toggle('is-active', r === row));
    const title = row.querySelector('.service-row__title')?.firstChild?.textContent?.trim();
    if (caption && title) caption.textContent = title;
  }

  rows.forEach((row) => {
    row.addEventListener('mouseenter', () => activate(row));
    row.addEventListener('focus', () => activate(row));
  });
</script>
