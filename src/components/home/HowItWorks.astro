---
import Icon from '~/components/Icon.astro';
import { tips } from '~/data/tips';
import { type Lang, anchors } from '~/i18n';
import { useTranslations } from '~/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="section section--sand how" aria-labelledby="process-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{t.process.eyebrow}</p>
      <h2 id="process-title">{t.process.title}</h2>
    </header>

    <ol class="steps">
      {
        t.process.steps.map((step, i) => (
          <li class="step" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <span class="step__num mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div id={anchors[lang].tips} class="tips" data-reveal>
      <div class="tips__head">
        <p class="eyebrow">{t.tips.eyebrow}</p>
        <h2>{t.tips.title}</h2>
      </div>
      <div class="tips__groups">
        {
          tips[lang].map((group) => (
            <div class="tips__group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    gap: 0;
    counter-reset: step;
  }

  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    padding: 1.75rem 0 2rem;
    border-top: 1px solid var(--line-strong);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 3px;
    background: var(--accent);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .step__num {
    display: block;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink-3);
  }

  .step h3 {
    margin-top: 1.25rem;
    font-size: var(--step-2);
  }

  .step p {
    margin-top: 0.6rem;
    color: var(--ink-2);
    max-width: 30em;
  }

  /* ---------- Tips ---------- */
  .tips {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .tips__head h2 {
    margin-top: 1rem;
    font-size: var(--step-3);
  }

  .tips__groups {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 900px) {
    .tips__groups {
      grid-template-columns: 1.25fr 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .tips__group h3 {
    padding-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: 1px solid var(--line-strong);
  }

  .tips__group ul {
    list-style: none;
  }

  .tips__group li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .tips__group li :global(svg) {
    margin-top: 0.15rem;
    color: var(--accent);
  }
</style>
